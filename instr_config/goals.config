normal_cron_verified = boolean : ( _normal and _normal_exec )
cron_persistence_created = count_greater : 0 : ( _persist )
persistence_execution_verified = count_greater : 0 : ( _persist_exec )
soc_detection_verified = boolean : ( _soc_state and _soc_alert )
incident_response_verified = boolean : ( _cleanup and _verified )
